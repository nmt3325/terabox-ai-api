# --- TeraBox credentials (pick ONE) ---------------------------------------
# 1) Netscape cookie file exported from a logged-in browser (recommended)
TERABOX_COOKIE_FILE=./cookies.txt
# 2) Just the ndus cookie value
# TERABOX_NDUS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 3) Raw Cookie header string
# TERABOX_COOKIE=ndus=xxxx; browserid=yyyy; csrfToken=zzzz

# --- Options ---------------------------------------------------------------
TERABOX_LANGUAGE=en
TERABOX_MODEL_ID=tera-ai
# Bearer token required by THIS local server (leave empty to disable auth)
# API_KEY=local-dev-key
